# Official Pi Testnet app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://youneon-app.vercel.app

# Pi.init sandbox is Testnet SDK access for this registered Testnet app.
# Default true on vercel.app, pinet.com, AND Studio/localhost.
# Studio vs Ecosystem is NOT sandbox:false — that creates Mainnet payments
# that Testnet Server API Keys cannot see (404 payment_not_found).
# Set to false only when this app moves to Mainnet.
NEXT_PUBLIC_PI_SANDBOX=true

# ---------------------------------------------------------------------------
# Pi Ecosystem vs Pi Develop — Testnet only. Do not mix keys.
#
# Approve/complete POST https://api.minepi.com/v2 with Authorization: Key PI_API_KEY.
# The Server API Key selects the app wallet. Linked App = None: use Develop
# API Key + Connected App Wallet (GCMX2…). Do NOT use old App Studio keys.
#
# TESTNET (required for this app):
#   1. Same production URL works from Studio AND Pi Apps → Open App
#   2. Vercel PI_API_KEY = Develop **Testnet / Sandbox Server API Key** for
#      Studio / sandbox.minepi.com (Connected App Wallet).
#      Vercel PI_API_KEY_PRODUCTION = Develop Testnet Server API Key for the
#      SAME Pi app listed as Open App (youneon-app.vercel.app / pinet.com).
#      NOT old App Studio keys. NOT Stripe. NOT a Production Mainnet key.
#   3. Pi.init sandbox is true (Testnet SDK) on Studio AND Open App.
#   4. Pay with Test-π. Payments land in the Connected App Wallet.
#
# Do not switch this app to Mainnet.
# If the key is wrong: wallet can look successful while server complete
# returns 401, and Pi Develop developer_completed stays gray.
# Redeploy on Vercel after any env change.
# ---------------------------------------------------------------------------

# Public Pi Sign-In OAuth client_id (Testnet, implicit flow only — no client_secret).
# This is NOT a payment API key. Set the same name on Vercel (build-time NEXT_PUBLIC_*).
# Redirect URIs are not configured yet in Pi Develop — add them there, e.g.
#   https://youneonwtce7005.pinet.com
#   https://youneon-app.vercel.app
NEXT_PUBLIC_PI_CLIENT_ID=w_xWQmfWJ4F48E4IztcO8W5ST0c6sCWa9q9uARUAtSQ

# Pi Platform Server API Keys (server-only). Required for U2A approve + complete.
# Never expose these to the client. Do not commit the real keys.
# Both keys are Testnet. On approve 404 with PI_API_KEY_PRODUCTION, the server
# retries once with PI_API_KEY. Same paymentId 404s if Pi.init used sandbox:false.
#
# PI_API_KEY=Develop Testnet Server API Key (Studio/sandbox)
# PI_API_KEY_PRODUCTION=Develop Testnet Server API Key for the Open App / production URL listing (same Testnet app as Ecosystem Open App)
PI_API_KEY=
PI_API_KEY_PRODUCTION=
PI_NETWORK_API_KEY=
# PI_PLATFORM_API_KEY=

# Optional Platform API base. Default is the official host (not sandbox.minepi.com —
# that URL is the desktop sandbox UI). Sandbox vs production is the API KEY.
# PI_PLATFORM_API_BASE=https://api.minepi.com/v2

# Pi app identity: NEXT_PUBLIC_PI_CLIENT_ID above is the OAuth client_id from
# Pi Develop → your app. The Vercel / pinet.com URL must be registered on that same app.

# Comma-separated Pi usernames that can open /admin (Sherifjaber is always included in code).
NEXT_PUBLIC_ADMIN_PI_USERNAMES=Sherifjaber

# Firebase Admin SDK (server-only). Required to create/claim promo codes after firestore.rules deny client writes.
# Paste a service account JSON as one line, or use the three fields below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=youneon
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Daily.co video rooms (server creates rooms; never commit .env.local).
# Get a key at https://dashboard.daily.co — set DAILY_API_KEY on Vercel/host.
DAILY_API_KEY=
# Your Daily subdomain (full host is youneon.daily.co)
NEXT_PUBLIC_DAILY_DOMAIN=youneon
