# Official Pi Testnet app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://youneonwtce7005.pinet.com

# Pi Network sandbox flag for the client SDK.
# "true"  = sandbox / testnet (sandbox.minepi.com)
# "false" = production Pi Network
# This project targets Pi Testnet. Keep this unless you intentionally switch mainnet payments.
NEXT_PUBLIC_PI_SANDBOX=true

# Public Pi Sign-In OAuth client_id (Testnet, implicit flow only — no client_secret).
# This is NOT a payment API key. Set the same name on Vercel (build-time NEXT_PUBLIC_*).
# Redirect URIs are not configured yet in Pi Develop — add them there, e.g.
#   https://youneonwtce7005.pinet.com
#   https://youneon-app.vercel.app
NEXT_PUBLIC_PI_CLIENT_ID=w_xWQmfWJ4F48E4IztcO8W5ST0c6sCWa9q9uARUAtSQ

# Pi Platform Server API Key (server-only). Never expose this to the client.
# The server also reads PI_API_KEY as an alias.
PI_NETWORK_API_KEY=

# Comma-separated Pi usernames that can open /admin (Sherifjaber is always included in code).
NEXT_PUBLIC_ADMIN_PI_USERNAMES=Sherifjaber

# Firebase Admin SDK (server-only). Required to create/claim promo codes after firestore.rules deny client writes.
# Paste a service account JSON as one line, or use the three fields below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=youneon
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Daily.co video rooms (server creates rooms; never commit .env.local).
# Get a key at https://dashboard.daily.co — set DAILY_API_KEY on Vercel/host.
DAILY_API_KEY=
# Your Daily subdomain (full host is youneon.daily.co)
NEXT_PUBLIC_DAILY_DOMAIN=youneon
